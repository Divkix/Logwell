{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/routes/**/+{page,server,page.server,error,layout,layout.server}{,@*}.{js,ts,svelte}",
        "src/lib/server/db/index.ts",
        "src/lib/server/auth.ts",
        "src/lib/server/jobs/cleanup-scheduler.ts"
      ],
      "project": ["src/**/*.{js,ts,svelte,css}"]
    }
  },
  "ignore": ["src/lib/components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/lib/server/utils/simple-ingest.ts": ["types"]
  },
  "ignoreDependencies": ["@divkix/logwell", "@typescript/native"],
  "ignoreUnresolved": ["\\$\\{packageName\\}"],
  "drizzle": false
}
