{
  "name": "logwell-app",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp -C . dev",
    "build": "vp -C . build",
    "preview": "vp -C . preview",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "knip": "knip",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down -v",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-admin.ts",
    "incidents:backfill": "bun run scripts/backfill-incidents.ts",
    "test": "vp test",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:component": "vp test run --project component",
    "test:e2e": "playwright test",
    "test:coverage": "vp test run --coverage",
    "test:ui": "vp test --ui",
    "sdk:test": "pnpm --dir sdks/typescript run test",
    "sdk:build": "pnpm --dir sdks/typescript run build",
    "sdk:lint": "pnpm --dir sdks/typescript run lint",
    "sdk:version": "pnpm --dir sdks/typescript exec npm version"
  },
  "dependencies": {
    "@lucide/svelte": "^1.46.0",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "layerchart": "^2.5.0",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "bits-ui": "^2.19.2",
    "jsdom": "^30.1.1",
    "knip": "^6.35.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.1",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
