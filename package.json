{
  "name": "logwell",
  "version": "1.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && husky && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "knip": "knip",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down -v",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed-admin.ts",
    "incidents:backfill": "bun run scripts/backfill-incidents.ts",
    "test": "vp test",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:component": "vp test run --project component",
    "test:e2e": "playwright test",
    "test:coverage": "vp test run --coverage",
    "test:ui": "vp test --ui",
    "sdk:test": "bun run --cwd sdks/typescript test",
    "sdk:build": "bun run --cwd sdks/typescript build",
    "sdk:lint": "bun run --cwd sdks/typescript lint",
    "sdk:version": "bun run --cwd sdks/typescript npm version"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "layerchart": "^2.4.0",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.11",
    "bits-ui": "^2.19.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.57.0",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "defu": "^6.1.7",
    "kysely": "^0.29.5",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "postcss": "^8.5.26",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.1"
}
