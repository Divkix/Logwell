set -e

# vp runs outside pnpm's verifyDepsBeforeRun check, so node_modules left stale by a
# pulled dependency change fails vite.config.ts with an unresolved import. No-op when current.
pnpm install --frozen-lockfile --prefer-offline --silent

vp staged
vp check
pnpm run knip

# The SDK has its own lint config; run it only when its files are staged.
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^sdks/typescript/'; then
  pnpm --dir sdks/typescript run check
fi
